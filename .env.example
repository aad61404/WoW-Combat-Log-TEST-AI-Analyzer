# Warcraft Logs API (required)
# Get your credentials at: https://www.warcraftlogs.com/api/clients/
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=

# Google Gemini API (required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
